# Copiar a .env.local. En Vercel van como Environment Variables.

# Públicas (viajan al navegador): las usan el login, el botón "Actualizar"
# (rpc force_refresh), Parámetros (colores y mapeo) y el zoom por usuario.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# SOLO servidor (sin NEXT_PUBLIC): la clave secreta del proyecto (Settings → API
# Keys → Secret keys). Con ella leen las rutas /api (snapshot, historial, GPS,
# alarmas, odómetro); el middleware decide quién entra. Nunca con prefijo
# NEXT_PUBLIC ni en código de cliente: salta la RLS.
SUPABASE_SECRET_KEY=<secret-key>

# IPs públicas de la oficina, separadas por coma: desde ahí /pantalla y sus APIs
# se ven sin sesión (la tele, Monitor Android). Vacía = nadie entra sin sesión.
OFFICE_IPS=

# La Function URL y la api-key de los Lambdas NO van acá: viven en Supabase Vault
# y las leen el cron y force_refresh() (supabase/auditoria_seguridad_fase1.sql).
